{
  "name": "stackvenn",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "wrangler dev",
    "check": "astro check && eslint . && prettier --check . && node scripts/check-contrast.mjs && npm run slop",
    "slop": "node scripts/check-slop.mjs --self-test && node scripts/check-slop.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^13.6.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.155.0"
  }
}
