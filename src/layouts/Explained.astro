---
// Explained format (DESIGN §4): docs layout.
// ≥1200px: sidebar | content | TOC. 960–1199: sidebar | content, TOC as a bar. <960: sidebar in a disclosure.
// The sidebar is sticky but never scrolls on its own: only the active section is expanded.
import type { MarkdownHeading } from 'astro';
import Shell from './Shell.astro';
import Corrections from '../components/Corrections.astro';
import ExplainedActions from '../components/ExplainedActions.astro';
import { SITE } from '../lib/site';
import { FORMAT_LABEL, SECTION, type Section } from '../lib/taxonomy';
import { formatDate, getPosts, readingTime, urlOf, type Post } from '../lib/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}
const { post, headings } = Astro.props;
const d = post.data;
const url = urlOf(post);
const abs = new URL(url, SITE.url).href;
// The real file (stories may be .md or .mdx), relative to the repo root.
const editUrl = `${SITE.repo}/edit/main/${(post.filePath ?? `src/content/${post.id}.mdx`).replace(/^\.\//, '')}`;
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const explained = await getPosts((p) => p.data.format === 'explained');
const bySection = new Map<Section, Post[]>();
for (const g of explained)
  bySection.set(g.data.section, [...(bySection.get(g.data.section) ?? []), g]);

const levelLabel = d.level ? d.level[0]!.toUpperCase() + d.level.slice(1) : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: d.headline,
    description: d.standfirst,
    url: abs,
    mainEntityOfPage: abs,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    inLanguage: SITE.locale,
    articleSection: SECTION[d.section].label,
    author: { '@id': `${SITE.url}/author/srihari-venkatesan#person` },
    publisher: { '@id': `${SITE.url}/#org` },
    ...(d.level ? { proficiencyLevel: levelLabel } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Explained', item: `${SITE.url}/explained` },
      { '@type': 'ListItem', position: 3, name: d.headline, item: abs },
    ],
  },
];
---

<Shell
  title={d.headline}
  description={d.standfirst}
  path={url}
  ogType="article"
  markdownTwin={`${url}.md`}
  publishedTime={d.published}
  modifiedTime={d.updated}
  noindex={d.status === 'draft'}
  jsonLd={jsonLd}
>
  <div class="container docs">
    <div class="sidebar" data-sidebar>
      <button
        type="button"
        class="btn btn-secondary btn-sm toggle"
        aria-expanded="false"
        aria-controls="explained-nav"
        data-sidebar-toggle
      >
        All Explained
      </button>
      <noscript>
        <style>
          .sidebar nav {
            display: grid;
          }
        </style>
      </noscript>
      <nav id="explained-nav" aria-label="Explained">
        {[...bySection].map(([section, items]) => (
          <details class="group" open={section === d.section}>
            <summary>{SECTION[section].label}</summary>
            <ul>
              {items.map((g) => (
                <li>
                  <a href={urlOf(g)} aria-current={g.id === post.id ? 'page' : undefined}>
                    {g.data.headline}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </nav>
    </div>

    <article class="content" data-pagefind-body>
      <span hidden data-pagefind-filter="section">
        {SECTION[d.section].label}
      </span>
      <span hidden data-pagefind-filter="format">
        {FORMAT_LABEL[d.format]}
      </span>
      <header>
        <p class="eyebrow" data-pagefind-ignore>
          <a href="/explained">Explained</a> <span aria-hidden="true">·</span>{' '}
          <a href={`/${d.section}`}>{SECTION[d.section].label}</a>
        </p>
        <h1>{d.headline}</h1>
        <p class="standfirst">{d.standfirst}</p>
        <dl class="meta-row" data-pagefind-ignore>
          {levelLabel && (
            <div>
              <dt>Level</dt>
              <dd>{levelLabel}</dd>
            </div>
          )}
          <div>
            <dt>Read</dt>
            <dd>{minutes} min</dd>
          </div>
          <div>
            <dt>Updated</dt>
            <dd>
              <time datetime={(d.updated ?? d.published).toISOString()}>
                {formatDate(d.updated ?? d.published)}
              </time>
            </dd>
          </div>
          {d.tested_with && d.tested_with.length > 0 && (
            <div>
              <dt>Tested with</dt>
              <dd class="mono">{d.tested_with.join(', ')}</dd>
            </div>
          )}
        </dl>
        <div data-pagefind-ignore>
          <ExplainedActions url={abs} markdown={`${url}.md`} />
        </div>
      </header>

      {d.summary && (
        <aside class="sixty" aria-labelledby="sixty-h">
          <h2 id="sixty-h">Explained in 60 seconds</h2>
          <ul>
            {d.summary.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </aside>
      )}

      {toc.length > 1 && (
        <details class="toc-bar">
          <summary>On this page</summary>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose explained-body">
        <slot />
      </div>

      <Corrections items={d.corrections} />

      <footer class="foot meta">
        <slot name="pager" />
        <a href={editUrl}>Edit on GitHub</a>
      </footer>
    </article>

    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {toc.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`} data-toc-link>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</Shell>

<script>
  // Sidebar starts collapsed on small screens; open on desktop (no-JS default is open).
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const toggle = sidebar?.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    sidebar?.classList.toggle('open', open);
  });

  // TOC scroll-spy.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (!visible.length) return;
        const id = visible[0]!.target.id;
        links.forEach((a) => a.toggleAttribute('data-active', a.hash === `#${id}`));
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .docs {
    display: grid;
    gap: var(--s-6);
    padding-block-start: var(--s-6);
  }
  .content {
    min-width: 0;
    max-width: var(--w-explained);
  }

  /* Sidebar */
  .sidebar nav {
    margin-block-start: var(--s-4);
    display: none;
    gap: var(--s-2);
  }
  .sidebar.open nav {
    display: grid;
  }
  .group > summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    padding-block: var(--s-2);
  }
  .group ul {
    list-style: none;
    padding: 0;
  }
  .group a {
    display: block;
    padding: var(--s-2) var(--s-3);
    color: var(--text-muted);
    text-decoration: none;
    border-inline-start: var(--bw-active) solid transparent;
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }
  .group a:hover {
    color: var(--text);
  }
  .group a[aria-current='page'] {
    color: var(--text);
    background: var(--raised);
    border-inline-start-color: var(--accent);
  }

  /* Header block */
  h1 {
    margin-block-start: var(--s-3);
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    font-weight: 700;
    letter-spacing: var(--ls-h1);
  }
  .standfirst {
    margin-block-start: var(--s-3);
    font-size: var(--fs-standfirst);
    line-height: var(--lh-standfirst);
    color: var(--text-muted);
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block: var(--s-5);
  }
  .meta-row div {
    display: inline-flex;
    border: var(--bw) solid var(--border);
    border-radius: var(--r-full);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    overflow: hidden;
  }
  .meta-row dt,
  .meta-row dd {
    padding: var(--s-1) var(--s-3);
  }
  .meta-row dt {
    color: var(--text-muted);
    border-inline-end: var(--bw) solid var(--border);
  }
  .meta-row dd {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .mono {
    font-family: var(--font-mono);
  }

  /* Guide prose uses the UI face for headings */
  .explained-body {
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    max-width: none;
  }
  .explained-body :global(h2),
  .explained-body :global(h3) {
    font-family: var(--font-ui);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* TOC: bar below 1200, rail at 1200+ */
  .toc-bar {
    margin-block-end: var(--s-6);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-md);
    padding: var(--s-3) var(--s-4);
  }
  .toc-bar summary {
    cursor: pointer;
    font-weight: 600;
  }
  .toc-bar ol,
  .toc ol {
    list-style: none;
    padding: 0;
  }
  .toc-bar ol {
    margin-block-start: var(--s-3);
  }
  .toc-bar a,
  .toc a {
    display: block;
    padding-block: var(--s-1);
    font-size: var(--fs-meta);
    color: var(--text-muted);
    text-decoration: none;
  }
  .toc-bar .d3,
  .toc .d3 {
    padding-inline-start: var(--s-3);
  }
  .toc {
    display: none;
  }
  .toc a {
    padding-inline-start: var(--s-3);
    border-inline-start: var(--bw-active) solid transparent;
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[data-active] {
    color: var(--accent-text);
    border-inline-start-color: var(--accent);
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .sixty {
    margin-block: var(--s-5) var(--s-7);
    padding: var(--s-5);
    background: var(--surface);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-md);
  }
  .sixty h2 {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-muted);
    margin-block-end: var(--s-3);
  }
  .sixty ul {
    display: grid;
    gap: var(--s-2);
    padding-inline-start: 1.1em;
    color: var(--text);
  }
  .sixty li::marker {
    color: var(--accent);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--bw) solid var(--border);
  }

  @media (min-width: 960px) {
    .docs {
      grid-template-columns: var(--w-sidebar) minmax(0, 1fr);
      gap: var(--s-7);
    }
    .sidebar .toggle {
      display: none;
    }
    .sidebar nav {
      display: grid;
      margin-block-start: 0;
    }
    .sidebar,
    .toc {
      position: sticky;
      top: calc(var(--h-header) + var(--s-5));
      align-self: start;
    }
  }
  @media (min-width: 1200px) {
    .docs {
      grid-template-columns: var(--w-sidebar) minmax(0, var(--w-explained)) var(--w-toc);
      justify-content: space-between;
      gap: var(--s-6);
    }
    .toc {
      display: block;
    }
    .toc-bar {
      display: none;
    }
    .toc .eyebrow {
      margin-block-end: var(--s-3);
    }
  }
</style>
