---
// Every page renders inside Shell: head/SEO, skip link, landmarks, header and footer.
import '../styles/global.css';
import Head, { type SeoProps } from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

type Props = SeoProps;
const props = Astro.props;

const sitewide = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    inLanguage: SITE.locale,
    publisher: { '@id': `${SITE.url}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#org`,
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    founder: { '@id': `${SITE.url}/about#person` },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...props} jsonLd={[...sitewide, ...(props.jsonLd ?? [])]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot name="above-header" />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
