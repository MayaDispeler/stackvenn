---
// Essays and field notes (DESIGN §3): one 680px column.
import Shell from './Shell.astro';
import OverlapChip from '../components/OverlapChip.astro';
import { SITE } from '../lib/site';
import { formatDate, readingTime, urlOf, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const url = urlOf(post);
const minutes = readingTime(post.body);
const isNote = d.type === 'note';
const is2am = d.series === '2-am';
const typeLabel = isNote ? 'Note' : 'Essay';
const firstPublished = d.first_published
  ? `First published on ${d.first_published.platform}, ${d.first_published.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}. Revised for Stackvenn.`
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.dek,
    url: new URL(url, SITE.url).href,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    inLanguage: SITE.locale,
    author: { '@id': `${SITE.url}/about#person` },
    publisher: { '@id': `${SITE.url}/#org` },
    about: d.pillar,
    ...(d.series
      ? {
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: d.series,
            url: `${SITE.url}/series/${d.series}`,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: isNote ? 'Notes' : 'Essays',
        item: `${SITE.url}/${isNote ? 'notes' : 'essays'}`,
      },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(url, SITE.url).href },
    ],
  },
];
---

<Shell
  title={d.title}
  description={d.dek}
  path={url}
  ogType="article"
  markdownTwin={`${url}.md`}
  publishedTime={d.published}
  modifiedTime={d.updated}
  noindex={d.status === 'draft'}
  jsonLd={jsonLd}
>
  <div class="progress" slot="above-header" aria-hidden="true">
    <span data-progress></span>
  </div>

  <article class:list={['container', 'essay', { note: isNote }]}>
    <header class="head">
      <nav class="crumbs meta" aria-label="Breadcrumb">
        <a href={isNote ? '/notes' : '/essays'}>{isNote ? 'Notes' : 'Essays'}</a>
        <span aria-hidden="true">/</span>
        <a href={`/topics/${d.pillar}`}>{d.pillar}</a>
      </nav>
      <p class="kicker">
        {is2am ? (
          <a class="column" href="/series/2-am">
            2 AM
          </a>
        ) : null}
        <OverlapChip overlap={d.overlap} />
        <span class="meta">· {typeLabel}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <p class="byline meta">
        <a href="/about">{SITE.author.name}</a>
        <span aria-hidden="true">·</span>
        <time datetime={d.published.toISOString()}>{formatDate(d.published)}</time>
        {d.updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
    </header>

    <div class="prose body">
      <slot />
    </div>

    {d.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-h">
        <h2 id="sources-h">Sources</h2>
        <ol>
          {d.sources.map((s) => (
            <li>
              <a href={s.url}>{s.title}</a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {firstPublished && <p class="origin meta">{firstPublished}</p>}

    <slot name="after" />
  </article>
</Shell>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.essay .body');
  if (bar && body && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* Pinned to the viewport top (not under the header), so it stays put when the mobile header hides. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: var(--h-progress);
    z-index: 60;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }
  .essay {
    max-width: calc(var(--w-essay) + var(--gutter) + var(--gutter-r));
    padding-block-start: var(--s-7);
  }
  .crumbs {
    display: flex;
    gap: var(--s-2);
    margin-block-end: var(--s-5);
  }
  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
    text-transform: capitalize;
  }
  .crumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-block-end: var(--s-4);
  }
  .column {
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    padding-inline-end: var(--s-2);
    border-inline-end: var(--bw) solid var(--border);
  }
  h1 {
    font-family: var(--font-read);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.01em;
  }
  .note h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
  }
  .dek {
    margin-block-start: var(--s-4);
    font-family: var(--font-read);
    font-style: italic;
    font-size: var(--fs-dek);
    line-height: var(--lh-dek);
    color: var(--text-muted);
  }
  .note .dek {
    font-style: normal;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-block: var(--s-5) var(--s-7);
    padding-block-end: var(--s-5);
    border-block-end: var(--bw) solid var(--border);
  }
  .byline a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .byline a:hover {
    text-decoration: underline;
  }
  .sources {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--bw) solid var(--border);
  }
  .sources h2 {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin-block-end: var(--s-3);
  }
  .sources ol {
    padding-inline-start: 1.25em;
    color: var(--text-muted);
    display: grid;
    gap: var(--s-2);
  }
  .origin {
    margin-block-start: var(--s-7);
  }
</style>
