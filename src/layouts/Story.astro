---
// Story page: Analysis, Opinion, Column and Brief (DESIGN §3). One 680px column.
import Shell from './Shell.astro';
import OverlapChip from '../components/OverlapChip.astro';
import { SITE } from '../lib/site';
import { COLUMNS, SECTION } from '../lib/taxonomy';
import { formatDate, kickerOf, readingTime, urlOf, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const url = urlOf(post);
const abs = new URL(url, SITE.url).href;
const minutes = readingTime(post.body);
const section = SECTION[d.section];
const column = d.column ? COLUMNS[d.column] : undefined;
const kicker = kickerOf(post);
const kickerHref = column ? `/columns/${d.column}` : undefined;
const isBrief = d.format === 'brief';
const firstPublished = d.first_published
  ? `First published on ${d.first_published.platform}, ${d.first_published.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}. Revised for Stackvenn.`
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type':
      d.format === 'analysis'
        ? 'AnalysisNewsArticle'
        : d.format === 'opinion' || d.format === 'column'
          ? 'OpinionNewsArticle'
          : 'BlogPosting',
    headline: d.headline,
    description: d.standfirst,
    url: abs,
    mainEntityOfPage: abs,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    inLanguage: SITE.locale,
    articleSection: section.label,
    author: { '@id': `${SITE.url}/author/srihari-venkatesan#person` },
    publisher: { '@id': `${SITE.url}/#org` },
    ...(column
      ? {
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: column.name,
            url: `${SITE.url}/columns/${d.column}`,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: section.label, item: `${SITE.url}/${d.section}` },
      { '@type': 'ListItem', position: 3, name: d.headline, item: abs },
    ],
  },
];
---

<Shell
  title={d.headline}
  description={d.standfirst}
  path={url}
  ogType="article"
  markdownTwin={`${url}.md`}
  publishedTime={d.published}
  modifiedTime={d.updated}
  noindex={d.status === 'draft'}
  jsonLd={jsonLd}
>
  <div class="progress" slot="above-header" aria-hidden="true">
    <span data-progress></span>
  </div>

  <article class:list={['container', 'story', { brief: isBrief }]}>
    <header class="head">
      <p class="kicker-row">
        <a class="section" href={`/${d.section}`}>
          {section.label}
        </a>
        <span class="rule" aria-hidden="true"></span>
        {kickerHref ? (
          <a class="kicker" href={kickerHref}>
            {kicker}
          </a>
        ) : (
          <span class="kicker">{kicker}</span>
        )}
      </p>
      <h1>{d.headline}</h1>
      <p class="standfirst">{d.standfirst}</p>
      <div class="byline">
        <OverlapChip overlap={d.overlap} />
        <p class="meta">
          By <a href="/author/srihari-venkatesan">{SITE.author.name}</a>
          <span aria-hidden="true">·</span>
          {d.dateline && <span class="dateline">{d.dateline},</span>}
          <time datetime={d.published.toISOString()}>{formatDate(d.published)}</time>
          {d.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
              </span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="prose body">
      <slot />
    </div>

    {d.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-h">
        <h2 id="sources-h">Sources</h2>
        <ol>
          {d.sources.map((s) => (
            <li>
              <a href={s.url}>{s.title}</a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {firstPublished && <p class="origin meta">{firstPublished}</p>}

    <slot name="after" />
  </article>
</Shell>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.story .body');
  if (bar && body && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* Pinned to the viewport top, so it stays put when the mobile header hides. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: var(--h-progress);
    z-index: 60;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }
  .story {
    max-width: calc(var(--w-story) + var(--gutter) + var(--gutter-r));
    padding-block-start: var(--s-7);
  }
  .kicker-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-end: var(--s-4);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }
  .section {
    color: var(--text);
    text-decoration: none;
  }
  .section:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .rule {
    width: var(--s-5);
    height: var(--bw);
    background: var(--border-strong);
  }
  .kicker {
    color: var(--accent-text);
    text-decoration: none;
  }
  a.kicker:hover {
    text-decoration: underline;
  }
  h1 {
    font-family: var(--font-read);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.01em;
  }
  .brief h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
  }
  .standfirst {
    margin-block-start: var(--s-4);
    font-family: var(--font-read);
    font-style: italic;
    font-size: var(--fs-standfirst);
    line-height: var(--lh-standfirst);
    color: var(--text-muted);
  }
  .brief .standfirst {
    font-style: normal;
  }
  .byline {
    display: grid;
    gap: var(--s-2);
    margin-block: var(--s-5) var(--s-7);
    padding-block-end: var(--s-5);
    border-block-end: var(--bw) solid var(--border);
  }
  .byline .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .byline a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .byline a:hover {
    text-decoration: underline;
  }
  .sources {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--bw) solid var(--border);
  }
  .sources h2 {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin-block-end: var(--s-3);
  }
  .sources ol {
    padding-inline-start: 1.25em;
    color: var(--text-muted);
    display: grid;
    gap: var(--s-2);
  }
  .origin {
    margin-block-start: var(--s-7);
  }
</style>
