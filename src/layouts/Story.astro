---
// Story page: Analysis, Opinion, Column and Brief (DESIGN §3). One 680px column.
import Shell from './Shell.astro';
import Corrections from '../components/Corrections.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image } from 'astro:assets';
import OverlapChip from '../components/OverlapChip.astro';
import ShareRow from '../components/ShareRow.astro';
import AuthorBox from '../components/AuthorBox.astro';
import StoryList from '../components/StoryList.astro';
import avatar from '../assets/author/avatar.webp';
import picks from '../data/frontpage.json';
import { SITE } from '../lib/site';
import { COLUMNS, FORMAT_LABEL, SECTION } from '../lib/taxonomy';
import {
  formatDate,
  getStories,
  kickerOf,
  readingTime,
  slugOf,
  urlOf,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const url = urlOf(post);
const abs = new URL(url, SITE.url).href;
const minutes = readingTime(post.body);
const section = SECTION[d.section];
const column = d.column ? COLUMNS[d.column] : undefined;
const kicker = kickerOf(post);
const kickerHref = column ? `/columns/${d.column}` : undefined;
const isBrief = d.format === 'brief';

// "More in <Section>": up to 3 other stories in this section.
const others = await getStories((p) => p.id !== post.id);
const moreInSection = others.filter((p) => p.data.section === d.section).slice(0, 3);
// "Editor's picks" until PostHog has real numbers (then "Most read"); never repeats the list above.
const shown = new Set(moreInSection.map((p) => p.id));
const editorsPicks = picks.picks
  .map((s) => others.find((p) => slugOf(p) === s))
  .filter((p): p is Post => !!p && !shown.has(p.id))
  .slice(0, 4);
const firstPublished = d.first_published
  ? `First published on ${d.first_published.platform}, ${d.first_published.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })}. Revised for Stackvenn.`
  : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type':
      d.format === 'analysis'
        ? 'AnalysisNewsArticle'
        : d.format === 'opinion' || d.format === 'column'
          ? 'OpinionNewsArticle'
          : 'BlogPosting',
    headline: d.headline,
    description: d.standfirst,
    url: abs,
    mainEntityOfPage: abs,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    inLanguage: SITE.locale,
    articleSection: section.label,
    author: { '@id': `${SITE.url}/author/srihari-venkatesan#person` },
    publisher: { '@id': `${SITE.url}/#org` },
    ...(column
      ? {
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: column.name,
            url: `${SITE.url}/columns/${d.column}`,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
      { '@type': 'ListItem', position: 2, name: section.label, item: `${SITE.url}/${d.section}` },
      { '@type': 'ListItem', position: 3, name: d.headline, item: abs },
    ],
  },
];
---

<Shell
  title={d.headline}
  description={d.standfirst}
  path={url}
  ogType="article"
  markdownTwin={`${url}.md`}
  publishedTime={d.published}
  modifiedTime={d.updated}
  noindex={d.status === 'draft'}
  jsonLd={jsonLd}
>
  <div class="progress" slot="above-header" aria-hidden="true">
    <span data-progress></span>
  </div>

  <article class:list={['container', 'story', { brief: isBrief }]} data-pagefind-body>
    <span hidden data-pagefind-filter="section">
      {section.label}
    </span>
    <span hidden data-pagefind-filter="format">
      {FORMAT_LABEL[d.format]}
    </span>
    <header class="head">
      <p class="kicker-row" data-pagefind-ignore>
        <a class="section" href={`/${d.section}`}>
          {section.label}
        </a>
        <span class="rule" aria-hidden="true"></span>
        {kickerHref ? (
          <a class="kicker" href={kickerHref}>
            {kicker}
          </a>
        ) : (
          <span class="kicker">{kicker}</span>
        )}
      </p>
      <h1>{d.headline}</h1>
      <p class="standfirst">{d.standfirst}</p>
      <div class="byline" data-pagefind-ignore>
        <OverlapChip overlap={d.overlap} />
        <p class="meta who">
          <a href="/author/srihari-venkatesan" tabindex="-1" aria-hidden="true">
            <Image src={avatar} alt="" width={32} height={32} class="avatar" />
          </a>
          By <a href="/author/srihari-venkatesan">{SITE.author.name}</a>
          <span aria-hidden="true">·</span>
          {d.dateline && <span class="dateline">{d.dateline},</span>}
          <time datetime={d.published.toISOString()}>{formatDate(d.published)}</time>
          {d.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
              </span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
        <div data-pagefind-ignore>
          <ShareRow url={abs} title={d.headline} />
        </div>
      </div>
    </header>

    <div class="prose body">
      <slot />
    </div>

    {d.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-h">
        <h2 id="sources-h">Sources</h2>
        <ol>
          {d.sources.map((s) => (
            <li>
              <a href={s.url}>{s.title}</a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <Corrections items={d.corrections} />

    {firstPublished && <p class="origin meta">{firstPublished}</p>}

    <slot name="after" />

    <footer class="end" data-pagefind-ignore>
      <ShareRow url={abs} title={d.headline} label="Share this story" toast={false} />
      <AuthorBox />
      <section class="comments" aria-labelledby="comments-h">
        <h2 id="comments-h">Comments</h2>
        {SITE.giscus ? (
          <button type="button" class="btn btn-secondary" data-load-comments>
            Load comments
          </button>
        ) : (
          <p class="meta">Comments open soon.</p>
        )}
      </section>
    </footer>
  </article>

  <div class="container more">
    {moreInSection.length > 0 && (
      <section aria-labelledby="more-h">
        <h2 id="more-h" class="label">
          More in <a href={`/${d.section}`}>{section.label}</a>
        </h2>
        <StoryList posts={moreInSection} showSection={false} headingLevel="h3" />
      </section>
    )}
    {editorsPicks.length > 0 && (
      <section aria-labelledby="picks-h">
        <h2 id="picks-h" class="label">
          Editor’s picks
        </h2>
        <StoryList posts={editorsPicks} headingLevel="h3" />
      </section>
    )}
  </div>
  <Lightbox />
</Shell>

<script>
  // Sidenotes: at ≥1200px each footnote also appears in the margin beside its reference.
  // The margin copy is aria-hidden; the footnote list stays in the page for assistive tech.
  const notes = document.querySelector<HTMLElement>('.story .body [data-footnotes]');
  if (notes) {
    notes.classList.add('has-sidenotes');
    document
      .querySelectorAll<HTMLAnchorElement>('.story .body a[data-footnote-ref]')
      .forEach((ref) => {
        const id = decodeURIComponent(ref.hash.slice(1));
        const note = document.getElementById(id);
        const block = ref.closest('p, li, blockquote');
        if (!note || !block) return;
        const side = document.createElement('span');
        side.className = 'sidenote';
        side.setAttribute('aria-hidden', 'true');
        const clone = note.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('[data-footnote-backref]').forEach((b) => b.remove());
        side.innerHTML = '<sup>' + (ref.textContent ?? '') + '</sup> ' + clone.innerHTML;
        block.classList.add('has-sidenote');
        block.appendChild(side);
      });
  }

  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.story .body');
  if (bar && body && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .who {
    align-items: center;
  }
  .who :global(.avatar) {
    width: var(--s-6);
    height: var(--s-6);
    border-radius: var(--r-full);
    border: var(--bw) solid var(--border);
  }
  .byline :global(.share) {
    margin-block-start: var(--s-2);
  }
  .end {
    display: grid;
    gap: var(--s-6);
    margin-block-start: var(--s-8);
  }
  .comments h2,
  .label {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 700;
    margin-block-end: var(--s-3);
  }
  .more {
    max-width: calc(var(--w-story) + var(--gutter) + var(--gutter-r));
    display: grid;
    gap: var(--s-7);
    margin-block-start: var(--s-8);
  }
  .more .label {
    padding-block-end: var(--s-3);
    margin-block-end: var(--s-5);
    border-block-end: var(--bw) solid var(--text);
  }
  .more .label a {
    color: inherit;
    text-decoration: none;
  }
  .more .label a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  /* Figures (rehype-figure turns image + italic line into figure + figcaption). */
  .body :global(figure) {
    margin-block: var(--s-6);
  }
  .body :global(figure img) {
    width: 100%;
    height: auto;
  }
  .body :global(figcaption) {
    margin-block-start: var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--text-muted);
  }

  /* Sidenotes: only where the margin fits them. */
  .body :global(.sidenote) {
    display: none;
  }
  @media (min-width: 1200px) {
    .body :global(.has-sidenote) {
      position: relative;
    }
    .body :global(.sidenote) {
      display: block;
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: calc(100% + var(--s-6));
      width: 220px;
      font-family: var(--font-ui);
      font-size: var(--fs-meta);
      line-height: var(--lh-meta);
      font-style: normal;
      color: var(--text-muted);
    }
    .body :global(.sidenote p) {
      display: inline;
    }
    .body :global(.has-sidenotes) {
      position: absolute !important;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Pinned to the viewport top, so it stays put when the mobile header hides. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: var(--h-progress);
    z-index: 60;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }
  .story {
    max-width: calc(var(--w-story) + var(--gutter) + var(--gutter-r));
    padding-block-start: var(--s-7);
  }
  .kicker-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-end: var(--s-4);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }
  .section {
    color: var(--text);
    text-decoration: none;
  }
  .section:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .rule {
    width: var(--s-5);
    height: var(--bw);
    background: var(--border-strong);
  }
  .kicker {
    color: var(--accent-text);
    text-decoration: none;
  }
  a.kicker:hover {
    text-decoration: underline;
  }
  h1 {
    font-family: var(--font-read);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.01em;
  }
  .brief h1 {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
  }
  .standfirst {
    margin-block-start: var(--s-4);
    font-family: var(--font-read);
    font-style: italic;
    font-size: var(--fs-standfirst);
    line-height: var(--lh-standfirst);
    color: var(--text-muted);
  }
  .brief .standfirst {
    font-style: normal;
  }
  .byline {
    display: grid;
    gap: var(--s-2);
    margin-block: var(--s-5) var(--s-7);
    padding-block-end: var(--s-5);
    border-block-end: var(--bw) solid var(--border);
  }
  .byline .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .byline a {
    color: var(--text-soft);
    text-decoration: none;
  }
  .byline a:hover {
    text-decoration: underline;
  }
  .sources {
    margin-block-start: var(--s-8);
    padding-block-start: var(--s-5);
    border-block-start: var(--bw) solid var(--border);
  }
  .sources h2 {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin-block-end: var(--s-3);
  }
  .sources ol {
    padding-inline-start: 1.25em;
    color: var(--text-muted);
    display: grid;
    gap: var(--s-2);
  }
  .origin {
    margin-block-start: var(--s-7);
  }
</style>
