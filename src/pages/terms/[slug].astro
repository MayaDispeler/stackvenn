---
// Terms (the glossary) at /terms/<slug>, in the docs layout.
import { render } from 'astro:content';
import Explained from '../../layouts/Explained.astro';
import { getPosts, slugOf, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const terms = await getPosts((p) => p.data.format === 'term');
  return terms.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
---

<Explained post={post} headings={headings}>
  <Content />
</Explained>
