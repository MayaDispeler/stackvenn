---
// Interim front page: masthead + latest list. The newspaper front page (DESIGN §2) replaces it in the next PR.
import List from '../layouts/List.astro';
import OverlapChip from '../components/OverlapChip.astro';
import Venn from '../components/Venn.astro';
import { SITE } from '../lib/site';
import { formatDate, getStories, kickerOf, readingTime, urlOf } from '../lib/posts';

const posts = await getStories();
---

<List title={SITE.name} description={SITE.description} heading="Latest" path="/" hideHeading>
  <section class="masthead container" slot="masthead" aria-labelledby="promise">
    <Venn size={64} class="mark" />
    <h1 id="promise">Where AI engineering, software and work overlap.</h1>
    <p class="standfirst">From an engineer who ships agentic AI in production.</p>
  </section>

  {posts.length === 0 ? (
    <p class="empty">The first posts are on their way.</p>
  ) : (
    <ol class="feed-list">
      {posts.map((p) => (
        <li>
          <OverlapChip overlap={p.data.overlap} />
          <h2>
            <a href={urlOf(p)}>{p.data.headline}</a>
          </h2>
          <p class="item-standfirst">{p.data.standfirst}</p>
          <p class="meta">
            {formatDate(p.data.published)} · {readingTime(p.body)} min · {kickerOf(p)}
          </p>
        </li>
      ))}
    </ol>
  )}
</List>

<style>
  .masthead {
    padding-block: var(--s-8) var(--s-6);
    border-block-end: var(--bw) solid var(--border);
  }
  .masthead :global(.mark) {
    margin-block-end: var(--s-5);
  }
  .masthead h1 {
    max-width: 18ch;
    font-family: var(--font-read);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    font-weight: 500;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.015em;
  }
  .standfirst {
    margin-block-start: var(--s-4);
    font-family: var(--font-read);
    font-style: italic;
    font-size: var(--fs-standfirst);
    line-height: var(--lh-standfirst);
    color: var(--text-muted);
  }
  .feed-list {
    list-style: none;
    padding: 0;
  }
  .feed-list li {
    padding-block: var(--s-5);
    border-block-end: var(--bw) solid var(--border);
  }
  .feed-list li:first-child {
    padding-block-start: 0;
  }
  .feed-list h2 {
    margin-block: var(--s-2) var(--s-1);
    font-size: var(--fs-feed-title);
    line-height: var(--lh-h3);
    font-weight: 700;
  }
  .feed-list h2 a {
    color: var(--text);
    text-decoration: none;
  }
  .feed-list h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .item-standfirst {
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-block-end: var(--s-2);
  }
  .empty {
    color: var(--text-muted);
  }
</style>
