---
// Corrections (policy at /about#corrections): dated notes at the end of a story, newest last.
import { formatDate } from '../lib/posts';

interface Props {
  items: { date: Date; text: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="corrections" aria-labelledby="corrections-h">
    <h2 id="corrections-h">Corrections</h2>
    <ul>
      {items.map((c) => (
        <li>
          <strong>
            Correction, <time datetime={c.date.toISOString()}>{formatDate(c.date)}</time>:
          </strong>{' '}
          {c.text}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .corrections {
    margin-block-start: var(--s-7);
    padding: var(--s-4) var(--s-5);
    background: var(--surface);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-md);
    font-family: var(--font-ui);
  }
  h2 {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 700;
    margin-block-end: var(--s-2);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    color: var(--text-soft);
  }
  strong {
    color: var(--text);
    font-weight: 600;
  }
</style>
