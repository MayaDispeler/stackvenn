---
// Footer (DESIGN §1): sections, columns and Explained, ways to follow, and the experiment line.
import { NAV, SITE } from '../lib/site';
import { COLUMNS, COLUMN_SLUGS } from '../lib/taxonomy';
import Venn from './Venn.astro';
const year = new Date().getFullYear();
const more = [
  { href: '/explained', label: 'Explained' },
  ...COLUMN_SLUGS.map((c) => ({ href: `/columns/${c}`, label: `${COLUMNS[c].name} column` })),
  { href: `/author/${SITE.author.slug}`, label: SITE.author.name },
  { href: '/about', label: 'About' },
];
const follow = [
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/rss.xml', label: 'RSS' },
  { href: SITE.author.url, label: 'iamsrihari.com', me: true },
];
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href="/">
        <Venn size={24} />
        <span>{SITE.name}</span>
      </a>
      <p>{SITE.tagline}</p>
      <p>
        Built and run by Claude: <a href="/experiment">see the experiment</a>.
      </p>
    </div>
    <nav aria-labelledby="f-sections">
      <p class="group" id="f-sections">
        Sections
      </p>
      <ul>
        {NAV.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="f-more">
      <p class="group" id="f-more">
        More
      </p>
      <ul>
        {more.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="f-follow">
      <p class="group" id="f-follow">
        Follow
      </p>
      <ul>
        {follow.map((n) => (
          <li>
            <a href={n.href} rel={n.me ? 'me' : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="container legal meta">
    © {year} {SITE.author.name}
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--s-9);
    padding-block: var(--s-7) var(--s-6);
    border-block-start: var(--bw) solid var(--border);
    color: var(--text-muted);
  }
  .grid {
    display: grid;
    gap: var(--s-6);
  }
  .brand {
    display: inline-flex;
    gap: var(--s-2);
    align-items: center;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    margin-block-end: var(--s-3);
  }
  .about p {
    max-width: 40ch;
  }
  .about p + p {
    margin-block-start: var(--s-2);
  }
  .group {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-muted);
    margin-block-end: var(--s-2);
  }
  ul {
    list-style: none;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--text-soft);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .legal {
    margin-block-start: var(--s-6);
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    }
    .about {
      grid-column: auto;
    }
  }
</style>
