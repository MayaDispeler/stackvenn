---
// Three-segment control: Light / Dark / System (DESIGN_SYSTEM §7). State comes from ThemeScript.
const options = [
  {
    value: 'light',
    label: 'Light theme',
    d: 'M12 4V2M12 22v-2M4.9 4.9 3.5 3.5M20.5 20.5l-1.4-1.4M4 12H2M22 12h-2M4.9 19.1l-1.4 1.4M20.5 3.5l-1.4 1.4M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  },
  {
    value: 'dark',
    label: 'Dark theme',
    d: 'M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401',
  },
  {
    value: 'system',
    label: 'System theme',
    d: 'M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM8 21h8M12 17v4',
  },
];
---

<div class="theme-toggle" role="group" aria-label="Colour theme">
  {options.map((o) => (
    <button type="button" data-theme-value={o.value} aria-pressed="false" aria-label={o.label}>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={o.d} />
      </svg>
    </button>
  ))}
</div>

<script>
  const sync = () => {
    const pref = document.documentElement.dataset.themePref ?? 'system';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === pref));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) =>
    b.addEventListener('click', () => {
      (window as unknown as { __setTheme: (p: string) => void }).__setTheme(
        b.dataset.themeValue ?? 'system',
      );
    }),
  );
  document.addEventListener('themechange', sync);
  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: var(--bw) solid var(--border);
    border-radius: var(--r-full);
  }
  button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: var(--r-full);
    background: transparent;
    color: var(--text-muted);
    transition:
      background-color var(--d-fast) var(--ease),
      color var(--d-fast) var(--ease);
  }
  button:hover {
    color: var(--text);
  }
  button[aria-pressed='true'] {
    background: var(--raised);
    color: var(--text);
  }
  @media (pointer: coarse) {
    button {
      width: var(--size-touch);
      height: var(--size-touch);
    }
  }
</style>
